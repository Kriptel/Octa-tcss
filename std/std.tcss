extern dynamic = std.dynamic;
extern enum = std.enum;
extern one_of = std.one_of;
extern unit = std.unit;

extern int     = std.int;
extern float   = std.float;
extern string  = std.string;
extern bool    = enum<true | false>;
extern color   = std.color;

extern size    = one_of<unit<int | float, px | % | rem | em | vh | vw> | enum<auto> | std.zero>;
extern angle   = unit<float, deg | rad | grad | turn>;
extern time    = unit<float, s | ms>;

extern display.mode = enum<block | inline | flex | grid | inline-block | inline-flex | none>;
extern position.mode = enum<relative | absolute | fixed | sticky>;
extern timing.function = enum<linear | ease | ease-in | ease-out | cubic-bezier>;
extern direction = enum<top | bottom | left | right | center>;
extern border.style = enum<none | solid | dashed | dotted | double>;
extern overflow.mode = enum<visible | hidden | scroll | auto>;
extern font.weight = enum<normal | bold | lighter | bolder | int>;
extern text.align = enum<left | right | center | justify>;
extern cursor.type = enum<default | pointer | text | wait | move | not-allowed>;

struct Spacing {
    size self;
    size top;
    size bottom;
    size left;
    size right;
}

extern rule root {
    display.mode display;
    position.mode position;
    
    // Sizing
    size width;
    size height;
    size minWidth;
    size minHeight;
    size maxWidth;
    size maxHeight;
    
    size top;
    size bottom;
    size left;
    size right;
    
    Spacing margin;
    
    Spacing padding;
   
    color background.color;
    color color;
    float opacity;
    int zIndex;
    
    string boxShadow;
    timing.function transitionTiming;
    time transitionDuration;
}